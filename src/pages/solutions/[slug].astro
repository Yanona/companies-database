---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";
import Icon, { type IconName } from "../../components/Icon.astro";
import Flag from "../../components/Flag.astro";
import SolutionMark from "../../components/SolutionMark.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import {
	breadcrumbJsonLd,
	formatDate,
	isAssociate,
	lastUpdated,
	mediaUrl,
	solutionJsonLd,
	withTerms,
	type Achievement,
} from "../../lib/solutions";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry, cacheHint } = await getEmDashEntry("solutions", slug);
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const s = await withTerms(entry);
const d = s.data;
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const origin = Astro.url.origin;
const path = `/solutions/${s.slug}`;

const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: origin,
	path,
	defaultTitle: `${d.title}: ${s.categories[0]?.label ?? "EdTech"} solution from Estonia`,
	defaultDescription: d.tagline,
	defaultOgImage: mediaUrl(origin, d.screenshots?.[0]?.image) ?? mediaUrl(origin, d.logo),
});

const primary = s.categories[0];
const crumbs = [
	{ name: "Solutions", path: "/" },
	...(primary ? [{ name: primary.label, path: `/categories/${primary.slug}` }] : []),
	{ name: d.title, path },
];
const updated = formatDate(lastUpdated(d));
const markets: string[] = d.markets ?? [];
const achievements: Achievement[] = d.achievements ?? [];
const OPEN_TO_ICONS: Record<string, IconName> = {
	"Distributors / resellers": "handshake",
	"Implementation partners": "puzzle",
	"Government tenders": "landmark",
	"Pilots with schools": "school",
	Investment: "coins",
};

const screenshots = (d.screenshots ?? []).filter((r: any) => r.image);
const status = d.company_status ?? "Active";
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	content={{ collection: "solutions", id: d.id, slug }}
	jsonLd={[...solutionJsonLd(origin, s), breadcrumbJsonLd(origin, crumbs)]}
>
	<div class="wrap" style="padding-block: 24px 0">
		<BackLink />

		<div class="d-head">
			<SolutionMark slug={s.slug} title={d.title} logo={d.logo} />
			<div style="min-width:0">
				<h1>
					<span {...entry.edit.title}>{d.title}</span>
					{isAssociate(d) && <span class="badge assoc">Associate member</span>}
				</h1>
				<p class="tag" {...entry.edit.tagline}>{d.tagline}</p>
				<div class="actions">
					<a class="btn primary" href={d.website} target="_blank" rel="noopener">
						Visit website
						<Icon name="arrow-up-right" />
					</a>
					{
						d.demo_video_url && (
							<a class="btn" href={d.demo_video_url} target="_blank" rel="noopener">
								Watch demo
								<Icon name="arrow-up-right" />
							</a>
						)
					}
					{
						d.contact_email && (
							<a class="btn icon-btn" href={`mailto:${d.contact_email}`} aria-label={`Email ${d.contact_email}`} title={d.contact_email}>
								<Icon name="mail" />
							</a>
						)
					}
					{
						d.linkedin_url && (
							<a class="btn icon-btn" href={d.linkedin_url} target="_blank" rel="noopener" aria-label={`${d.title} on LinkedIn`} title="LinkedIn">
								<Icon name="linkedin" />
							</a>
						)
					}
				</div>
				{
					status !== "Active" && (
						<p class="notice" role="status">
							{status === "Closed"
								? `${d.title} has closed. This page is kept for reference.`
								: `${d.title} is currently inactive. Information may be out of date.`}
						</p>
					)
				}
			</div>
		</div>

		<div class="d-body">
			<div class="d-main">
				<section>
					<h2>About {d.title}</h2>
					<div class="prose" {...entry.edit.description}><PortableText value={d.description} /></div>
				</section>

				<section>
					<h2>Screenshots</h2>
					<div class="shots">
						{
							screenshots.length > 0
								? screenshots.map((r: any, i: number) => (
										<Image image={r.image} alt={r.image.alt || `${d.title} screenshot ${i + 1}`} />
									))
								: [1, 2, 3].map((n) => <div class="shot-empty">Screenshot {n}</div>)
						}
					</div>
				</section>

				<section>
					<h2>Who it’s for</h2>
					<div class="who">
						{
							s.categories.length > 0 && (
								<div class="who-row">
									<span>Category</span>
									<div class="chips">
										{s.categories.map((t) => <a class="chip" href={`/categories/${t.slug}`}>{t.label}</a>)}
									</div>
								</div>
							)
						}
						{
							s.levels.length > 0 && (
								<div class="who-row">
									<span>Education level</span>
									<div class="chips">
										{s.levels.map((t) => <a class="chip plain" href={`/levels/${t.slug}`}>{t.label}</a>)}
									</div>
								</div>
							)
						}
						{
							s.users.length > 0 && (
								<div class="who-row">
									<span>Target users</span>
									<div class="chips">{s.users.map((t) => <span class="chip plain">{t.label}</span>)}</div>
								</div>
							)
						}
					</div>
				</section>

				{
					achievements.length > 0 && (
						<section>
							<h2>Achievements</h2>
							<ul class="ach">
								{achievements.map((a) => (
									<li>
										<span class="type">{a.type}</span>
										<span>{a.url ? <a href={a.url} rel="noopener">{a.name}</a> : a.name}</span>
										<span class="yr">{a.year}</span>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</div>

			<aside class="facts" aria-label="Key facts">
				<dl>
					{d.founded_year && (<div><dt>Founded</dt><dd class="num">{d.founded_year}</dd></div>)}
					{d.hq_city && (<div><dt>Headquarters</dt><dd>{d.hq_city}</dd></div>)}
					<div><dt>Membership</dt><dd>{d.membership ?? "Member"}</dd></div>
					<div><dt>Works offline</dt><dd>{d.works_offline ? "Yes" : "No"}</dd></div>
					{updated && (<div><dt>Last updated</dt><dd>{updated}</dd></div>)}
				</dl>

				{
					d.product_languages?.length > 0 && (
						<div class="block">
							<h3>Product languages</h3>
							<p class="icon-line">
								<Icon name="languages" />
								<span>{d.product_languages.join(", ")}</span>
							</p>
						</div>
					)
				}

				{
					markets.length > 0 && (
						<div class="block">
							<h3>Used in {markets.length} {markets.length === 1 ? "country" : "countries"}</h3>
							<div class="countries">
								{markets.map((m) => (
									<span class="country">
										<Flag country={m} />
										{m}
									</span>
								))}
							</div>
						</div>
					)
				}

				{
					d.open_to?.length > 0 && (
						<div class="block">
							<h3>Open to</h3>
							<ul class="icon-list">
								{d.open_to.map((o: string) => (
									<li class="icon-line">
										<Icon name={OPEN_TO_ICONS[o] ?? "handshake"} />
										<span>{o}</span>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</aside>
		</div>
	</div>
</Base>
