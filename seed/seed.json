			{
				"id": "arvupesa",
				"slug": "arvupesa",
				"status": "published",
				"data": {
					"title": "Arvupesa",
					"tagline": "Arvupesa is an adaptive maths practice platform for grades 1–9 that turns curriculum topics into short game levels.",
					"description": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Arvupesa covers maths from counting to linear equations through more than 2,000 game levels. Each level targets one skill, and the platform adjusts the difficulty after every answer so pupils stay challenged without getting stuck. A wrong answer brings up a short hint or a worked example instead of a red cross."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Teachers assign topics in a few clicks and see in real time which skills the class has mastered and where individual pupils need help. Schools use Arvupesa for homework, differentiated practice in class and holiday catch-up programmes. Content is mapped to the national curriculum in each country where it is offered."
								}
							]
						}
					],
					"website": "https://arvupesa.example",
					"founded_year": 2016,
					"hq_city": "Tallinn",
					"membership": "Member",
					"product_languages": [
						"Estonian",
						"English",
						"Finnish",
						"German"
