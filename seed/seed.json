	"content": {
		"solutions": [
			{
				"id": "lugemiskaru",
				"slug": "lugemiskaru",
				"status": "published",
				"data": {
					"title": "Lugemiskaru",
					"tagline": "Lugemiskaru is a reading app that teaches children aged 4–9 to read through short illustrated stories and phonics games.",
					"description": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Lugemiskaru turns early reading practice into a daily ten-minute routine. Each session pairs a short illustrated story with phonics and word-building games that adapt to the child’s pace. Stories are written by children’s authors and recorded by native speakers, so children hear correct pronunciation while they read along."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Teachers get a class overview showing which sounds and words each child has mastered, and parents receive a weekly summary. The full story library can be downloaded to a tablet, so the app works in classrooms and homes without a stable internet connection. New languages are added together with local publishers."
								}
							]
						}
					],
					"website": "https://lugemiskaru.example",
					"founded_year": 2018,
					"hq_city": "Tartu",
					"membership": "Member",
					"product_languages": [
						"Estonian",
						"English",
						"Russian",
						"Ukrainian"
					],
					"markets": [
						"Estonia",
						"Latvia",
						"Finland",
						"Ukraine"
					],
					"works_offline": true,
					"achievements": [
						{
							"type": "Award",
							"name": "Baltic Early Literacy Prize, winner",
							"year": 2024
						},
						{
							"type": "Research",
							"name": "Reading fluency pilot in 14 Estonian kindergartens",
							"year": 2023
						}
					],
					"open_to": [
						"Distributors / resellers",
						"Pilots with schools"
					],
					"demo_video_url": "https://lugemiskaru.example/demo",
					"contact_email": "info@lugemiskaru.example",
					"linkedin_url": "https://linkedin.example/company/lugemiskaru",
					"company_status": "Active",
					"registry_code": "SAMPLE",
					"source": "Admin",
					"admin_notes": "Fictional sample entry. Delete before launch."
				},
				"taxonomies": {
