{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edtech-estonia-directory",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edtech-estonia-directory",
			"database_id": "cc56b371-ed51-43f2-9462-50ed7c568fb2",
		},
	],
	// R2 media bucket not created yet. Uncomment once it exists:
	// "r2_buckets": [
	// 	{
	// 		"binding": "MEDIA",
	// 		"bucket_name": "edtech-estonia-media",
	// 	},
	// ],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
